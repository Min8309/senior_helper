# Optional: leave both blank to store memories only in this browser.
VITE_SUPABASE_URL=
# Use the public anon/publishable key, never the service_role/secret key.
VITE_SUPABASE_ANON_KEY=

# Optional: absolute HTTPS URL of your deployed n8n photo analysis webhook.
# The frontend deployment does not include an analysis server.
VITE_N8N_ANALYZE_WEBHOOK=
